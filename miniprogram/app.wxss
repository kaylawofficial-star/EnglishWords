page {
  min-height: 100%;
  background: #f3f8fc;
  color: #18324b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  margin: 0 0 12rpx;
  color: #3478b8;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page-title {
  margin: 0;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-intro {
  margin: 16rpx 0 32rpx;
  color: #66798b;
  font-size: 30rpx;
  line-height: 1.6;
}

.mode-notice {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #dceef8;
  color: #255f94;
  font-size: 28rpx;
  line-height: 1.5;
}

.summary-card,
.status-card {
  box-sizing: border-box;
  width: 100%;
  padding: 40rpx;
  border: 2rpx solid #dce5ec;
  border-radius: 32rpx;
  background: #ffffff;
}

.summary-card {
  margin-bottom: 24rpx;
}

.card-label {
  margin-bottom: 12rpx;
  color: #66798b;
  font-size: 26rpx;
}

.card-title {
  margin-bottom: 32rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.metric-row {
  display: flex;
  gap: 16rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f3f8fc;
}

.metric-value {
  display: block;
  overflow-wrap: anywhere;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.metric-label {
  display: block;
  margin-top: 8rpx;
  color: #66798b;
  font-size: 24rpx;
}

.status-card {
  text-align: center;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
}

.status-copy {
  margin-top: 12rpx;
  color: #66798b;
  font-size: 28rpx;
  line-height: 1.55;
}

.retry-button {
  min-height: 96rpx;
  margin-top: 32rpx;
  border: 2rpx solid #3478b8;
  border-radius: 999rpx;
  background: #ffffff;
  color: #255f94;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.retry-button:active {
  background: #dceef8;
}
